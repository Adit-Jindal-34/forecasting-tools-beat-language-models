# Copy to env.sh on the cluster and fill in. env.sh is gitignored.
export TSARCH=/path/to/project/root
export TSARCH_NAME=<first name, lowercase>
export TSARCH_BITSID=<your institute id>
export TSARCH_PROJECT=tsarch

# The vLLM server is addressed over localhost; no key is needed.
# If a hosted provider is used instead, set its key here.
# export OPENAI_API_KEY=...
